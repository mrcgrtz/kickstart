{
	"name": "kickstart",
	"version": "5.0.0-alpha3",
	"private": true,
	"description": "This is my Kickstart toolset, serving as a boilerplate for new projects written in PHP, CSS and JavaScript.",
	"license": "MIT",
	"repository": "github:mrcgrtz/kickstart",
	"author": "Marc Görtz <git@marcgoertz.de> (https://marcgoertz.de/)",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "gulp",
		"format": "prettier --write .",
		"lint": "npm run-script lint:js && npm run-script lint:ts && npm run-script lint:css",
		"lint:js": "xo",
		"lint:ts": "tsc --noEmit --strict",
		"lint:css": "stylelint ./public/css/src/**/*.css",
		"prepare": "husky",
		"watch": "gulp watch"
	},
	"keywords": [
		"boilerplate",
		"php",
		"html",
		"css",
		"javascript",
		"template"
	],
	"devDependencies": {
		"@csstools/postcss-global-data": "^4.0.0",
		"browserslist-config-mrcgrtz": "^1.0.1",
		"browserslist-to-esbuild": "^2.1.1",
		"cssnano": "^9.9.0",
		"esbuild": "^0.28.2",
		"gulp": "^5.0.1",
		"gulp-concat": "^2.6.1",
		"gulp-postcss": "^10.0.0",
		"gulp-sourcemaps": "^3.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"postcss": "^8.5.32",
		"postcss-assets": "^6.0.0",
		"postcss-custom-properties": "^15.0.4",
		"postcss-flexbugs-fixes": "^5.0.2",
		"postcss-preset-env": "^11.6.1",
		"postcss-svgo": "^9.1.0",
		"prettier": "^3.9.10",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-formatter-pretty": "^4.0.1",
		"stylelint-prettier": "^5.0.3",
		"stylelint-use-logical": "^2.1.3",
		"typescript": "^6.0.3",
		"xo": "^5.0.1"
	}
}
